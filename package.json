{
  "name": "dsh-dev-progress-memory",
  "description": "DSH plugin: dev progress tracking, system bug memory, token optimization, and context compact continuation",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whding110/dsh-dev-progress-memory.git"
  },
  "homepage": "https://github.com/whding110/dsh-dev-progress-memory#readme",
  "bugs": {
    "url": "https://github.com/whding110/dsh-dev-progress-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "progress"
  ],
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
